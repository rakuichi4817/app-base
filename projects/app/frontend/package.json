{
	"name": "app-base-frontend",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"packageManager": "pnpm@12.15.0",
	"engines": {
		"node": "24.22.2",
		"pnpm": "12.15.0"
	},
	"scripts": {
		"dev": "vite",
		"build": "vue-tsc -b && vite build",
		"preview": "vite preview",
		"lint": "eslint . --max-warnings 0 && prettier --check . && vue-tsc -b",
		"format": "eslint . --fix --max-warnings 0 && prettier --write .",
		"test": "vitest run",
		"storybook": "storybook dev -p 6006 --no-open",
		"build-storybook": "storybook build",
		"test-storybook": "vitest run --config vitest.storybook.config.ts"
	},
	"dependencies": {
		"@tanstack/vue-query": "^5.102.8",
		"reka-ui": "^2.10.4",
		"vue": "^3.5.40"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@storybook/addon-a11y": "^10.6.5",
		"@storybook/addon-vitest": "^10.6.5",
		"@storybook/vue3-vite": "^10.6.5",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^24.13.3",
		"@vitejs/plugin-vue": "^6.0.8",
		"@vitest/browser-playwright": "^4.1.12",
		"@vue/test-utils": "^2.4.6",
		"eslint": "^10.10.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-better-tailwindcss": "^4.7.0",
		"eslint-plugin-vue": "^10.11.0",
		"globals": "^17.12.0",
		"jsdom": "^29.0.0",
		"license-checker-rseidelsohn": "^5.0.1",
		"playwright": "^1.64.1",
		"prettier": "^3.9.7",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"storybook": "^10.6.5",
		"tailwindcss": "^4.3.3",
		"typescript": "~6.0.2",
		"typescript-eslint": "^8.70.0",
		"vite": "^8.2.0",
		"vitest": "^4.1.11",
		"vue-tsc": "^3.3.8"
	}
}

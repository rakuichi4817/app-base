{
	"name": "app-base-frontend",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"packageManager": "pnpm@12.15.0",
	"engines": {
		"node": "26.13.1",
		"pnpm": "12.15.0"
	},
	"scripts": {
		"dev": "vite",
		"build": "vue-tsc -b && vite build",
		"preview": "vite preview",
		"lint": "eslint . --max-warnings 0 && prettier --check . && vue-tsc -b",
		"format": "eslint . --fix --max-warnings 0 && prettier --write .",
		"test": "vitest run",
		"storybook": "storybook dev -p 6006 --no-open",
		"build-storybook": "storybook build"
	},
	"dependencies": {
		"@tanstack/vue-query": "^5.108.0",
		"reka-ui": "^2.11.0",
		"vue": "^3.5.45"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@storybook/addon-a11y": "^10.6.7",
		"@storybook/vue3-vite": "^10.6.7",
		"@tailwindcss/vite": "^4.3.5",
		"@types/node": "^26.6.6",
		"@vitejs/plugin-vue": "^6.0.11",
		"@vue/test-utils": "^2.6.0",
		"eslint": "^10.15.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-better-tailwindcss": "^4.11.0",
		"eslint-plugin-vue": "^10.12.1",
		"globals": "^17.14.0",
		"jsdom": "^31.0.0",
		"license-checker-rseidelsohn": "^5.0.1",
		"prettier": "^3.10.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"storybook": "^10.6.7",
		"tailwindcss": "^4.3.5",
		"typescript": "~6.0.3",
		"typescript-eslint": "^8.73.0",
		"vite": "^8.3.8",
		"vitest": "^5.1.0",
		"vue-tsc": "^3.3.14"
	}
}
